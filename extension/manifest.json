{
  "manifest_version": 3,
  "name": "大肥鱼 · 抖音弹幕桥",
  "version": "1.0.0",
  "description": "把抖音直播间的弹幕 / 礼物 / 进场抓给大肥鱼直播页，并把大肥鱼的回复自动发回直播间。",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://live.douyin.com/*",
    "https://www.douyin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://live.douyin.com/*", "https://www.douyin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "大肥鱼弹幕桥",
    "default_popup": "popup.html"
  }
}
